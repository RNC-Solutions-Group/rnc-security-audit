# Example harness configuration. Copy to harness.toml (Git-ignored) and edit.
# Scanner executables/images are selected from the local run/ artifact manifest;
# no source repository or commit is supplied to the harness.
schema_version = 1

[artifact]
# Local operator manifest. The default is run/manifest.toml.
# manifest = "run/manifest.toml"
# Optional default build id when the manifest registers multiple builds.
# build = "rnc-cp4a"

[scanner]
# Used only as a default assertion when --build selects a registered build.
default = "gitleaks"

[targets]
# Active products: Windows AMD64 native, Docker Linux AMD64, Docker Linux ARM64.
platforms = ["host"]

[suites]
# Baseline "all" = Levain + Leaky Repo only; other suites are explicit.
# `rnclab` is the standalone certified RNC Synthetic Secrets Lab v3 and is
# never included in `all`.
default = ["levain", "leaky-repo"]

[performance]
warmups = 1
measured_runs = 5
# DEV: contended developer host (default; functional/preliminary only)
# CONTROLLED: reduced contention, documented host conditions
# RELEASE: pinned artifacts, default scanner config, controlled hardware
environment = "DEV"
# Reserved optional stress dimensions: none, cpu, memory, io, network.
stress_profile = "none"

[reports]
formats = ["markdown", "json"]
naming = "{timestamp}-{scanner}-{commit}-{profile}"

[reports.sanitized]
enabled = true
location = "reports/experiments/"

[reports.unsanitized]
enabled = false
location = "reports/unsanitized/"

[reports.summary]
enabled = true
console = true

[reports.exceptions]
enabled = true
mode = "exceptions-only"
include_coverage_gaps = true
include_skipped = true
include_not_applicable = false
include_baseline_deltas = true

[execution]
timeout = 1200

[cache]
dir = "datasets/cache"
