{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rncsolutionsgroup.com/security-audit/v0.2/result.schema.json",
  "title": "Immutable finalized result",
  "description": "The summary classification is independently computed from execution, detection and policy records. JSON Schema constrains the obvious impossible combinations; the CP0 cross-record validator enforces the full count, precedence and record-digest invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "result_code",
    "result",
    "coverage",
    "evidence_valid",
    "engine_version",
    "ruleset_id",
    "ruleset_digest",
    "source_adapter",
    "counts",
    "reason_codes",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "result_code": {"enum": [1, 2, 3, 4, 5]},
    "result": {"enum": ["CLEAN", "POLICY_APPLIED", "ACTIONABLE", "INCOMPLETE", "FAILED"]},
    "coverage": {"enum": ["COMPLETE", "COMPLETE_POLICY_ADJUSTED", "PARTIAL", "NONE", "UNVERIFIED"]},
    "evidence_valid": {"type": "boolean"},
    "engine_version": {"type": "string", "minLength": 1},
    "ruleset_id": {"type": "string", "minLength": 1},
    "ruleset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "inspected",
        "verified_blocked",
        "uninspected",
        "required_discovered",
        "required_inspected",
        "required_verified_blocked",
        "required_uninspected",
        "detected",
        "actionable",
        "exempted"
      ],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "inspected": {"type": "integer", "minimum": 0},
        "verified_blocked": {"type": "integer", "minimum": 0},
        "uninspected": {"type": "integer", "minimum": 0},
        "required_discovered": {"type": "integer", "minimum": 0},
        "required_inspected": {"type": "integer", "minimum": 0},
        "required_verified_blocked": {"type": "integer", "minimum": 0},
        "required_uninspected": {"type": "integer", "minimum": 0},
        "detected": {"type": "integer", "minimum": 0},
        "actionable": {"type": "integer", "minimum": 0},
        "exempted": {"type": "integer", "minimum": 0}
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_digest", "findings_digest", "policy_digest"],
      "properties": {
        "execution_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "findings_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"result_code": {"const": 1}}, "required": ["result_code"]}, "then": {"properties": {"result": {"const": "CLEAN"}}}},
    {"if": {"properties": {"result_code": {"const": 2}}, "required": ["result_code"]}, "then": {"properties": {"result": {"const": "POLICY_APPLIED"}}}},
    {"if": {"properties": {"result_code": {"const": 3}}, "required": ["result_code"]}, "then": {"properties": {"result": {"const": "ACTIONABLE"}}}},
    {"if": {"properties": {"result_code": {"const": 4}}, "required": ["result_code"]}, "then": {"properties": {"result": {"const": "INCOMPLETE"}}}},
    {"if": {"properties": {"result_code": {"const": 5}}, "required": ["result_code"]}, "then": {"properties": {"result": {"const": "FAILED"}}}},
    {
      "if": {"properties": {"result_code": {"const": 1}}, "required": ["result_code"]},
      "then": {
        "properties": {
          "coverage": {"const": "COMPLETE"},
          "evidence_valid": {"const": true},
          "reason_codes": {"maxItems": 0},
          "counts": {
            "properties": {
              "required_discovered": {"minimum": 1},
              "required_uninspected": {"const": 0},
              "verified_blocked": {"const": 0},
              "required_verified_blocked": {"const": 0},
              "detected": {"const": 0},
              "actionable": {"const": 0},
              "exempted": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"result_code": {"const": 2}}, "required": ["result_code"]},
      "then": {
        "properties": {
          "coverage": {"const": "COMPLETE_POLICY_ADJUSTED"},
          "evidence_valid": {"const": true},
          "reason_codes": {"maxItems": 0},
          "counts": {
            "properties": {
              "required_discovered": {"minimum": 1},
              "required_uninspected": {"const": 0},
              "actionable": {"const": 0}
            },
            "anyOf": [
              {"properties": {"verified_blocked": {"minimum": 1}}},
              {"properties": {"exempted": {"minimum": 1}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"result_code": {"const": 3}}, "required": ["result_code"]},
      "then": {
        "properties": {
          "coverage": {"enum": ["COMPLETE", "COMPLETE_POLICY_ADJUSTED"]},
          "evidence_valid": {"const": true},
          "reason_codes": {"maxItems": 0},
          "counts": {
            "properties": {
              "required_discovered": {"minimum": 1},
              "required_uninspected": {"const": 0},
              "actionable": {"minimum": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"result_code": {"const": 4}}, "required": ["result_code"]},
      "then": {
        "properties": {
          "reason_codes": {"minItems": 1},
          "coverage": {"enum": ["PARTIAL", "NONE", "UNVERIFIED"]}
        }
      }
    },
    {
      "if": {"properties": {"result_code": {"const": 5}}, "required": ["result_code"]},
      "then": {"properties": {"reason_codes": {"minItems": 1}}}
    }
  ]
}
