{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rncsolutionsgroup.com/security-audit/v0.2/finding.schema.json",
  "title": "Unmodified detector finding event",
  "description": "Detector-owned evidence. It never carries a policy disposition, raw credential bytes, or a user-facing path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "finding_id",
    "unit_id",
    "rule_id",
    "rule_version",
    "category",
    "start_byte",
    "end_byte",
    "line",
    "confidence",
    "validation",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "finding_id": {
      "type": "string",
      "pattern": "^f-[0-9a-f]{64}$",
      "description": "Stable identity: sha256(unit_id + NUL + rule_id + NUL + rule_version + NUL + start_byte + NUL + end_byte + NUL + evidence_digest), prefixed f-."
    },
    "unit_id": {"type": "string", "pattern": "^u-[0-9a-f]{64}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "start_byte": {"type": "integer", "minimum": 0},
    "end_byte": {"type": "integer", "minimum": 1},
    "line": {"type": "integer", "minimum": 1},
    "line_end": {"type": "integer", "minimum": 1},
    "confidence": {"enum": ["low", "medium", "high", "unknown"]},
    "validation": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the exact matched bytes. Raw bytes remain in the private evidence store."
    }
  }
}
