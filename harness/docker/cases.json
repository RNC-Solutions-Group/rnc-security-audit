    {"glob": "testdata/baseline/**", "root": "repo", "disposition": "INTERNAL GO TEST ONLY", "reason": "Baseline matching and format parsing are package-level tests.", "tests": []},
    {"glob": "testdata/expected/**", "root": "repo", "disposition": "INTERNAL GO TEST ONLY", "reason": "Expected report snapshots validate Go report writers; they are not CLI findings manifests.", "tests": []},
    {"glob": "testdata/report/**", "root": "repo", "disposition": "INTERNAL GO TEST ONLY", "reason": "Custom template rendering is asserted by report package tests.", "tests": []},
    {"glob": "testdata/gitleaksignore/**", "root": "repo", "disposition": "INTERNAL GO TEST ONLY", "reason": "Windows path normalization fixture is exercised by a detector unit test.", "tests": []},
