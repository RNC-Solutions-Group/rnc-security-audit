    {"glob": "testdata/config/invalid/allowlist_global_empty.toml", "root": "repo", "override": true, "disposition": "COVERED", "reason": "The empty global allowlist config is explicitly rejected by the CLI in invalid-config.", "tests": ["invalid-config"]},
