    {"glob": "testdata/config/simple.toml", "root": "repo", "disposition": "COVERED", "reason": "Explicit CLI rule selection and positive/negative file scans.", "tests": ["nogit-positive", "ignorefile-api-suppression", "git-history", "symlink-file", "formats"]},
    {"glob": "testdata/config/generic.toml", "root": "repo", "disposition": "COVERED", "reason": "CLI scan of the existing hidden .env.prod fixture.", "tests": ["hidden-env"]},
