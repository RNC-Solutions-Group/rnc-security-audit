version = 1

[secret_detection]
enabled = true
ruleset = "synthetic-v1"
ruleset_digest = "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

[exclusions]
paths = ["vendor/**", "generated/**"]

[limits]
max_file_bytes = 1048576
max_total_bytes = 8388608
timeout_ms = 120000
max_findings = 1000

[reporting]
sanitized = true

[ci]
accepted_result_codes = [1, 2]