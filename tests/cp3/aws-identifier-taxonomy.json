{
  "schema_version": 1,
  "dataset_id": "cp3-aws-identifier-taxonomy",
  "dataset_version": "2026.11.2-corrective",
  "reviewed": "2026-11-11",
  "references": [
    "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html",
    "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_bearer.html"
  ],
  "credential_classes": {
    "access-key-id": {
      "prefixes": ["AKIA", "ASIA"],
      "description": "Documented access-key identifiers; AKIA is long-term and ASIA is temporary STS. Presence is not proof of an active or usable credential.",
      "expected_rule_id": "aws-access-key-id",
      "confidence": "high"
    },
    "service-bearer-token-id": {
      "prefixes": ["ABIA"],
      "description": "Access key ID component of an AWS STS service bearer token. The bare identifier is not the complete bearer token and does not establish service or Region scope.",
      "expected_rule_id": "aws-sts-service-bearer-token-id",
      "confidence": "medium"
    },
    "context-specific-credential-id": {
      "prefixes": ["ACCA"],
      "description": "AWS documents ACCA as a context-specific credential prefix. Public documentation does not define the complete credential or usable scope.",
      "expected_rule_id": "aws-context-specific-credential-id",
      "confidence": "medium"
    },
    "resource-identifier": {
      "prefixes": ["AIDA", "AGPA", "AIPA", "ANPA", "ANVA", "APKA", "AROA", "ASCA"],
      "description": "Ordinary IAM resource identifiers. These must not be reported as access-key credentials.",
      "expected_rule_id": null,
      "confidence": null
    }
  },
  "cases": [
    {
      "case_id": "01-akia-access-key",
