  "test_dimensions": {
    "modes": ["whole", "stream"],
    "strategies": ["regex", "regexset", "prefilter", "auto"],
    "required_invariants": [
      "resource identifiers produce no credential finding",
      "AKIA and ASIA map only to aws-access-key-id",
      "ABIA and ACCA map only to their distinct rules",
      "invalid prefix, length, character set and documentation placeholder produce no finding",
      "multiple identifiers on one line remain distinct occurrences",
      "whole and streaming results are identical",
      "all four strategy selections are equivalent"
